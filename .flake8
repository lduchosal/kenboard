# flake8 est scopé aux seules règles DCO (flake8-docstrings-complete :
# complétude des docstrings — args/returns/raises documentés). Tout le reste
# (pycodestyle E/W, pyflakes F, pydocstyle D) est porté par ruff — cf.
# [tool.ruff.lint] dans pyproject.toml (ken #993). À retirer entièrement
# quand la famille DOC de ruff (pydoclint) sortira de preview.
[flake8]
select = DCO
extend-ignore = DCO020, DCO030, DCO031, DCO060
exclude =
    .git,
    __pycache__,
    .venv,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .tox
