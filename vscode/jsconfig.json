{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "typeRoots": ["../node_modules/@types"],
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.js"]
}
